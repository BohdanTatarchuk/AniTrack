<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/pearl">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsingToolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_scrollFlags="scroll|exitUntilCollapsed">

            <!-- Banner Image -->
            <ImageView
                android:id="@+id/profileBanner"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:contentDescription="@string/profile_banner"
                android:scaleType="centerCrop"
                android:background="@color/darkBlue"
                app:layout_collapseMode="parallax"
                tools:src="@tools:sample/backgrounds/scenic" />

        </com.google.android.material.appbar.CollapsingToolbarLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Profile Header Container -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginNormal"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingHorizontal="@dimen/layoutHorizontalPadding">

                <!-- Avatar -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/cardCornerRadius"
                    app:cardElevation="0dp"
                    app:strokeWidth="0dp">

                    <ImageView
                        android:id="@+id/profileAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/profile_avatar"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/profile_picture" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Username -->
                <TextView
                    android:id="@+id/profileUsername"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/marginSmall"
                    android:fontFamily="@font/comfortaa"
                    android:textColor="@color/darkBlue"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="AniTrackUser" />

            </LinearLayout>

            <!-- Navigation Tabs Box -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/layoutHorizontalPadding"
                android:layout_marginTop="@dimen/marginNormal"
                app:cardBackgroundColor="@color/darkBlue10op"
                app:cardCornerRadius="@dimen/cardCornerRadius"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:rowCount="2"
                    android:padding="@dimen/marginSmall">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnOverview"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/overview"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAnimeList"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/anime_list"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMangaList"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/manga_list"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFavorites"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/favorites"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSocial"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/social"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnStats"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:fontFamily="@font/comfortaa"
                        android:text="@string/stats"
                        android:textAllCaps="false"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        app:backgroundTint="@android:color/transparent"
                        app:cornerRadius="@dimen/buttonCornerRadius" />

                </GridLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Content Container (Placeholder for child fragments) -->
            <FrameLayout
                android:id="@+id/profileContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginSmall" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
