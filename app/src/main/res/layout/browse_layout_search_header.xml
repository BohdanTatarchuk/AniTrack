<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/layoutHorizontalPadding"
    android:paddingTop="@dimen/marginSmall">

    <!-- Search Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_search_bar"
        android:gravity="center_vertical"
        android:padding="@dimen/inputFieldPadding">

        <EditText
            android:id="@+id/searchEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:fontFamily="@font/comfortaa"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:textColor="@color/pearl"
            android:textColorHint="@color/lightGrey"
            android:textSize="@dimen/bodyTextSize" />

        <ImageButton
            android:id="@+id/searchButton"
            android:layout_width="@dimen/iconSizeMedium"
            android:layout_height="@dimen/iconSizeMedium"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/search_icon"
            android:src="@drawable/ic_search"
            app:tint="@color/pearl" />

    </LinearLayout>

    <!-- Media Type Selection -->
    <LinearLayout
        android:id="@+id/dropdownMediaType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/marginSmall"
        android:background="@drawable/bg_dropdown"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/inputFieldPadding">

        <TextView
            android:id="@+id/textMediaType"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/comfortaa"
            android:text="@string/media_type"
            android:textColor="@color/darkGrey"
            android:textSize="@dimen/bodyTextSize" />

        <ImageView
            android:layout_width="@dimen/iconSizeMedium"
            android:layout_height="@dimen/iconSizeMedium"
            android:contentDescription="@string/dropdown_icon"
            android:src="@drawable/ic_dropdown" />

    </LinearLayout>

    <!-- Filters Section (Collapsible) -->
    <LinearLayout
        android:id="@+id/filtersContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/marginSmall"
        android:orientation="vertical">

        <!-- Filters Header -->
        <LinearLayout
            android:id="@+id/filtersHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="@dimen/marginTiny">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/comfortaa"
                android:text="@string/filters"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/sectionTitleFontSize"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/iconFiltersToggle"
                android:layout_width="@dimen/iconSizeMedium"
                android:layout_height="@dimen/iconSizeMedium"
                android:contentDescription="@string/filters"
                android:rotation="180"
                android:src="@drawable/ic_dropdown"
                android:tint="@color/darkBlue" />

        </LinearLayout>

        <!-- Filters Content (Collapsible) -->
        <LinearLayout
            android:id="@+id/filtersContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/marginTiny"
            android:orientation="vertical">

            <!-- Add Filter Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddFilter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/accentBlue"
                android:fontFamily="@font/comfortaa"
                android:text="+ Add Filter"
                android:textAllCaps="false"
                android:textColor="@color/pearl"
                android:textSize="@dimen/bodyTextSize"
                app:cornerRadius="@dimen/buttonCornerRadius"
                app:icon="@drawable/ic_filter"
                app:iconGravity="start"
                app:iconTint="@color/pearl" />

            <!-- More Filter Options Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMoreOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:backgroundTint="@color/darkBlue35op"
                android:fontFamily="@font/comfortaa"
                android:text="@string/more_filter_options"
                android:textAllCaps="false"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/bodyTextSize"
                app:cornerRadius="@dimen/buttonCornerRadius"
                app:icon="@drawable/ic_dropdown"
                app:iconGravity="end"
                app:iconTint="@color/darkBlue"
                app:rippleColor="@color/darkBlue10op" />

            <!-- Advanced Filters Container (Expandable) -->
            <include
                android:id="@+id/advancedFilters"
                layout="@layout/browse_layout_advanced_filters"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginSmall" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
