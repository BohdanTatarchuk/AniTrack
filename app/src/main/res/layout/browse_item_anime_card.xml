<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/layoutHorizontalPadding"
    android:layout_marginBottom="@dimen/marginMicro"
    app:cardBackgroundColor="@color/pearl"
    app:cardCornerRadius="@dimen/cardCornerRadius"
    app:cardElevation="@dimen/zero"
    app:strokeColor="@color/darkBlue35op"
    app:strokeWidth="@dimen/dividerHeight">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="160dp">

        <!-- Left: Clean Cover Image (no overlay) -->
        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="110dp"
            android:layout_height="160dp"
            android:contentDescription="@string/anime_poster"
            android:scaleType="centerCrop"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0"
            tools:src="@tools:sample/backgrounds/scenic" />

        <!-- Right: Details Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/marginMicro"
            android:paddingEnd="@dimen/marginMicro"
            android:paddingTop="@dimen/marginMicro"
            android:paddingBottom="@dimen/marginMicro"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/posterImage"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0">

            <!-- Title (moved from image overlay to here) -->
            <TextView
                android:id="@+id/posterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/comfortaa"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/labelFontSize"
                android:textStyle="bold"
                tools:text="Anime/Manga Title Here" />

            <!-- Release Info -->
            <TextView
                android:id="@+id/releaseInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paddingTiny"
                android:fontFamily="@font/comfortaa"
                android:textColor="@color/darkGrey"
                android:textSize="@dimen/bodyTextSize"
                tools:text="2007 - 2017" />

            <!-- Score Badge (now in vertical flow) -->
            <LinearLayout
                android:id="@+id/scoreBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/scoreIcon"
                    android:layout_width="@dimen/iconSizeMedium"
                    android:layout_height="@dimen/iconSizeMedium"
                    android:contentDescription="@string/score_icon"
                    tools:src="@drawable/ic_score_positive" />

                <TextView
                    android:id="@+id/scoreText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/paddingTiny"
                    android:fontFamily="@font/comfortaa"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/bodyTextSize"
                    android:textStyle="bold"
                    tools:text="75%" />

            </LinearLayout>

            <!-- Next Episode Info (optional) -->
            <TextView
                android:id="@+id/nextEpisodeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:fontFamily="@font/comfortaa"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/captionTextSize"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Ep 10 airing in 5 days, 21 hours"
                tools:visibility="visible" />

            <!-- Footer: Studio/Source -->
            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:ellipsize="end"
                android:fontFamily="@font/comfortaa"
                android:maxLines="1"
                android:textColor="@color/darkGrey"
                android:textSize="@dimen/captionTextSize"
                tools:text="Studio MAPPA" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
