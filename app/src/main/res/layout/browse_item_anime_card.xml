<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/layoutHorizontalPadding"
    android:layout_marginBottom="@dimen/marginSmall"
    app:cardBackgroundColor="@color/pearl"
    app:cardCornerRadius="@dimen/cardCornerRadius"
    app:cardElevation="@dimen/zero"
    app:strokeColor="@color/darkBlue35op"
    app:strokeWidth="@dimen/dividerHeight">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Left: Cover Image with Title Overlay -->
        <FrameLayout
            android:id="@+id/posterContainer"
            android:layout_width="120dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="2:3"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/posterImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/anime_poster"
                android:scaleType="centerCrop"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Title Overlay at bottom of image -->
            <TextView
                android:id="@+id/posterTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_anime_card_title_overlay"
                android:ellipsize="end"
                android:fontFamily="@font/comfortaa"
                android:maxLines="2"
                android:padding="@dimen/marginTiny"
                android:textColor="@color/white"
                android:textSize="@dimen/captionTextSize"
                android:textStyle="bold"
                tools:text="Anime/Manga name" />

        </FrameLayout>

        <!-- Right: Details Section -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/marginSmall"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/posterContainer"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Release Info Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/releaseInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/comfortaa"
                    android:textColor="@color/darkBlue"
                    android:textSize="@dimen/bodyTextSize"
                    android:textStyle="bold"
                    tools:text="2007 - 2017" />

                <!-- Score Badge -->
                <LinearLayout
                    android:id="@+id/scoreBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/scoreIcon"
                        android:layout_width="@dimen/iconSizeMedium"
                        android:layout_height="@dimen/iconSizeMedium"
                        android:contentDescription="@string/score_icon"
                        tools:src="@drawable/ic_score_positive" />

                    <TextView
                        android:id="@+id/scoreText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/paddingTiny"
                        android:fontFamily="@font/comfortaa"
                        android:textColor="@color/darkBlue"
                        android:textSize="@dimen/bodyTextSize"
                        android:textStyle="bold"
                        tools:text="75%" />

                </LinearLayout>

            </LinearLayout>

            <!-- Next Episode Info (optional) -->
            <TextView
                android:id="@+id/nextEpisodeInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/paddingTiny"
                android:fontFamily="@font/comfortaa"
                android:textColor="@color/darkBlue"
                android:textSize="@dimen/captionTextSize"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Ep 10 airing in\n5 days, 21 hours"
                tools:visibility="visible" />

            <!-- Tagline -->
            <TextView
                android:id="@+id/tagline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:fontFamily="@font/comfortaa"
                android:textColor="@color/darkGrey"
                android:textSize="@dimen/captionTextSize"
                android:textStyle="italic"
                tools:text="A boy fights... for the right death." />

            <!-- Description -->
            <TextView
                android:id="@+id/description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:ellipsize="end"
                android:fontFamily="@font/comfortaa"
                android:lineSpacingMultiplier="1.2"
                android:maxLines="5"
                android:textColor="@color/darkGrey"
                android:textSize="@dimen/smallCaptionTextSize"
                tools:text="Hardship, regret, shame: the negative feelings that humans feel become Curses that lurk in our everyday lives. The Curses run rampant throughout the world, capable of leading people to terrible misfortune and even death." />

            <!-- Footer: Studio/Source -->
            <TextView
                android:id="@+id/footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/marginTiny"
                android:ellipsize="end"
                android:fontFamily="@font/comfortaa"
                android:maxLines="2"
                android:textColor="@color/darkGrey"
                android:textSize="@dimen/smallCaptionTextSize"
                tools:text="Itadori Yuji is a boy with tremendous physical strength, though he lives a completely ordinary high school life. One day" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
